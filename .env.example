# Kafka broker
KAFKA_BOOTSTRAP=localhost:19092

# MinIO (S3-compatible)
MINIO_ENDPOINT=http://localhost:19000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Bronze/Silver paths (MinIO S3A for Spark, local path for scripts)
BRONZE_PATH=s3a://bronze
SILVER_PATH=s3a://silver

# DuckDB (used by dbt + dashboard)
DUCKDB_PATH=dbt/job_market.duckdb

# Airflow
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=sqlite:///airflow/airflow.db
